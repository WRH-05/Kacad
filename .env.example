# Forward waitlist submissions to any JSON webhook (Zapier, Make, n8n, etc.)
WAITLIST_WEBHOOK_URL=

# Optional separate destination for general inquiries.
# Falls back to WAITLIST_WEBHOOK_URL when empty.
CONTACT_WEBHOOK_URL=

# Optional overriding brochure URL. Defaults to the bundled placeholder.
BROCHURE_URL=

# Optional shared secret sent as x-kennedy-secret to the webhook.
WEBHOOK_SECRET=

# Optional staging override for the public WhatsApp number.
# NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Supabase ---------------------------------------------------------------
# Project URL. NEXT_PUBLIC_* values are inlined at build time, so rebuild after
# changing them.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (or legacy anon) key, safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key, server-side only. Used by maintenance scripts (seeding, admin
# provisioning) and never exposed through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# First admin account, read only by scripts/create-admin.mjs.
ADMIN_EMAIL=
ADMIN_PASSWORD=
